---
import TestimonialCard from "./TestimonialCard.astro";

// Create custom avatars at https://getavataaars.com
import testimonialsImage1 from "@assets/placeholder/testimonial_1.svg";
import testimonialsImage2 from "@assets/placeholder/testimonial_2.svg";
---

<div class="container mx-auto px-4 py-16 sm:px-6 lg:px-8">
  <div class="text-center mb-10">
    <h1 class="text-3xl font-bold mb-1.5">Customers love us</h1>
    <p class="text-base-500 max-w-md mx-auto font-medium">
      Lorem aliquip sit consequat tempor voluptate cupidatat elit cillum
      consectetur duis.
    </p>
  </div>

  <div class="grid gap-8 md:grid-cols-2">
    <!-- Testimonial Card 1 -->
    <TestimonialCard
      name="John Doe"
      position="CEO at Company"
      image={testimonialsImage1}
    >
      <p>
        "I didn't believe in perfection until I met you. Now I question
        everything I know about life, the universe, and my own worth."
      </p>
    </TestimonialCard>

    <TestimonialCard
      name="John Doe"
      position="CEO at Company"
      image={testimonialsImage2}
    >
      <p>
        "Best experience I've ever had working with a person ever. Like honestly
        how can you be such a perfect human being."
      </p>
    </TestimonialCard>
  </div>
</div>
