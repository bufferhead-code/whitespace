---
import { Image } from "astro:assets";

interface Props {
  name: string;
  position: string;
  image?: ImageMetadata;
}

const { name, position, image } = Astro.props;
---

<div class="rounded-2xl border border-base-200 bg-white p-8 shadow-xs">
  <div class="flex items-center gap-4">
    {
      image && (
        <Image
          src={image}
          alt={name}
          class="h-12 w-12 rounded-full object-cover"
        />
      )
    }
    <div>
      <h3 class="font-medium">{name}</h3>
      <p class="text-base-600 font-medium text-sm">{position}</p>
    </div>
  </div>
  <div class="mt-6 text-base-700">
    <slot />
  </div>
</div>
