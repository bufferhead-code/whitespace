---
import SectionTitle from "../Common/SectionTitle.astro";
import ExperienceRowTwo from "./ExperienceRowTwo.astro";
import acmeLogo from "@assets/placeholder/acme_square.svg";

import alphaWaveLogo from "@assets/placeholder/alphawave_square.svg";
import altShiftLogo from "@assets/placeholder/altshift_square.svg";
import boldShiftLogo from "@assets/placeholder/boltshift_square.svg";
---

<div class="container mx-auto pt-6 pb-12 border-t border-gray-200">

    <div class="pt-3 grid lg:grid-cols-2 gap-y-4 gap-x-12">
        <div>
            <SectionTitle>Experience</SectionTitle>
            <ExperienceRowTwo
                    image={acmeLogo}
                    timeFrame="Jan 2010 - Feb 2015"
                    role="Remote Full-Stack Developer"
                    company="ACME Corp, World"
            />

            <ExperienceRowTwo
                    image={alphaWaveLogo}
                    timeFrame="Jan 2010 - Feb 2015"
                    role="Remote Full-Stack Developer"
                    company="ACME Corp, World"
            />

            <ExperienceRowTwo
                    image={altShiftLogo}
                    timeFrame="Jan 2010 - Feb 2015"
                    role="Remote Full-Stack Developer"
                    company="ACME Corp, World"
            />

            <ExperienceRowTwo
                    image={boldShiftLogo}
                    timeFrame="Jan 2010 - Feb 2015"
                    role="Remote Full-Stack Developer"
                    company="ACME Corp, World"
            />
        </div>
        <div>
            <SectionTitle>Education</SectionTitle>
            <ExperienceRowTwo
                    image={acmeLogo}
                    timeFrame="Jan 2010 - Feb 2015"
                    role="Remote Full-Stack Developer"
                    company="ACME Corp, World"
            />

            <ExperienceRowTwo
                    image={alphaWaveLogo}
                    timeFrame="Jan 2010 - Feb 2015"
                    role="Remote Full-Stack Developer"
                    company="ACME Corp, World"
            />

            <ExperienceRowTwo
                    image={altShiftLogo}
                    timeFrame="Jan 2010 - Feb 2015"
                    role="Remote Full-Stack Developer"
                    company="ACME Corp, World"
            />

            <ExperienceRowTwo
                    image={boldShiftLogo}
                    timeFrame="Jan 2010 - Feb 2015"
                    role="Remote Full-Stack Developer"
                    company="ACME Corp, World"
            />
        </div>
    </div>
</div>
