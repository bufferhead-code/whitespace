---
import { Image } from "astro:assets";

interface Props {
  timeFrame?: string;
  title: string;
  image?: ImageMetadata;
}

const { timeFrame, title, image } = Astro.props;
---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
  <!-- Left column with heading -->
  <div class="lg:col-span-3">
    <h2 class="font-medium tracking-tight text-gray-600">{timeFrame}</h2>
  </div>

  <div class="lg:col-span-9">
    <div class="flex space-x-4 mb-2">
      {
        image && (
          <Image
            src={image}
            alt={title}
            class="w-12 h-12 p-2 shadow-xs border border-gray-200 rounded-lg"
          />
        )
      }
      <div class="space-y-0.5 flex-1">
        <h3 class="font-semibold">{title}</h3>
        <div class="text-gray-600 max-w-2xl prose prose-sm">
          <slot />
        </div>
      </div>
    </div>
  </div>
</div>
