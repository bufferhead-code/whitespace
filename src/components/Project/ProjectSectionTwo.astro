---
import ProjectCard from "./ProjectCard.astro";
import ButtonSecondary from "../Button/ButtonSecondary.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
// sort by priority
allProjects.sort((a, b) => b.data.priority - a.data.priority);
---

<section class="container mx-auto pt-8 pb-12 border-t border-base-200 isolate">
  <!-- Projects grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
    {
      allProjects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          slug={project.id}
          logo={project.data.logo}
          image={project.data.image}
        />
      ))
    }
  </div>

  <!-- See all projects button -->
  <div class="flex justify-center">
    <ButtonSecondary> See all projects </ButtonSecondary>
  </div>
</section>
