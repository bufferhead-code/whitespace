---
import ProjectCard from "./ProjectCard.astro";
import ButtonSecondary from "../Button/ButtonSecondary.astro";
import SectionTitle from "../Common/SectionTitle.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
// sort by priority
allProjects.sort((a, b) => b.data.priority - a.data.priority);
---

<section class="container mx-auto pt-6 pb-12 border-t border-base-200 isolate">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Left column with heading -->
    <div class="lg:col-span-3">
      <SectionTitle>Projects</SectionTitle>
    </div>

    <!-- Right column with content -->
    <div class="lg:col-span-9">
      <!-- Description text -->
      <p class="text-xl mb-8 font-medium">
        I've worked on many projects over my 10+ years in the industry, creating
        innovative solutions for various companies.
      </p>

      <!-- Projects grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        {
          allProjects.map((project) => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              image={project.data.image}
              slug={project.id}
            />
          ))
        }
      </div>

      <!-- See all projects button -->
      <div class="flex justify-center">
        <ButtonSecondary> See all projects </ButtonSecondary>
      </div>
    </div>
  </div>
</section>
