---
import { Image } from "astro:assets";

interface Props {
  title: string;
  description?: string;
  slug: string;
  image: ImageMetadata;
  logo?: ImageMetadata;
}

const { title, description, image, logo, slug } = Astro.props;
---

<div>
  <a href={`/projects/${slug}`} class="relative">
    <div
      class="border-base-200 border shadow-xs hover:shadow transition relative bg-base-100 group rounded-xl overflow-hidden"
    >
      <Image
        src={image}
        alt={title}
        class="w-full aspect-video object-cover transition duration-500 object-top group-hover:scale-102"
      />
    </div>
    {
      logo && (
        <div class="rounded-lg absolute shadow-sm bg-white/60 backdrop-blur border-base-300 border p-[3px] -bottom-6 right-5">
          <div class=" overflow-hidden aspect-square rounded h-13 w-13">
            <Image
              src={logo}
              alt={title + " Logo"}
              class="w-full h-full  object-cover bg-base-100 "
            />
          </div>
        </div>
      )
    }
  </a>
  <div class="px-2 py-3">
    <h3 class="text font-semibold mb-0.5">{title}</h3>
    <p class="text-base-500 font-medium text-sm">
      {description}
    </p>
  </div>
</div>
