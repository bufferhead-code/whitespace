---
import { Image } from "astro:assets";
import ButtonSecondary from "../Button/ButtonSecondary.astro";
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description?: string;
  image: ImageMetadata;
  logo?: ImageMetadata;
}

const { title, description, image, logo } = Astro.props;
---

<div>
  <div class="relative">
    <div
      class="border-gray-200 border shadow-xs relative bg-gray-100 group rounded-xl overflow-hidden"
    >
      <div
        class="backdrop-blur-xs absolute w-full h-full duration-300 opacity-0 group-hover:opacity-100 flex items-center justify-center bg-white/30"
      >
        <ButtonSecondary>
          <div class="flex items-center font-medium gap-0.5">
            <span>See Project</span>
            <Icon name="mdi:external-link" class="w-4 text-gray-500 h-4 ml-1" />
          </div>
        </ButtonSecondary>
      </div>
      <Image
        src={image}
        alt={title}
        class="w-full h-64 object-cover transition duration-500"
      />
    </div>
    {
      logo && (
        <div class="rounded-lg absolute shadow-sm bg-white/60 backdrop-blur border-gray-300 border p-[3px] -bottom-6 right-5">
          <div class=" overflow-hidden aspect-square rounded h-13 w-13">
            <Image
              src={logo}
              alt={title + " Logo"}
              class="w-full h-full  object-cover bg-gray-100 "
            />
          </div>
        </div>
      )
    }
  </div>
  <div class="px-2 py-3">
    <h3 class="text font-semibold mb-0.5">{title}</h3>
    <p class="text-gray-500 font-medium text-sm">
      {description}
    </p>
  </div>
</div>
