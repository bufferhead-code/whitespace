---
import ButtonSecondary from "../Button/ButtonSecondary.astro";
import ProjectRow from "./ProjectRow.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
// sort by priority
allProjects.sort((a, b) => b.data.priority - a.data.priority);
---

<section class="container mx-auto border-t border-gray-200 isolate">
  <div class="divide-y divide-gray-200">
    {
      allProjects.map((project) => (
        <ProjectRow
          title={project.data.title}
          description={project.data.description}
          tags={project.data.tags}
          image={project.data.image}
        />
      ))
    }
  </div>

  <!-- See all projects button -->
  <div class="flex justify-center pb-10">
    <ButtonSecondary> See all projects </ButtonSecondary>
  </div>
</section>
