---
import SectionTitle from "../Common/SectionTitle.astro";
import StackItem from "./StackItem.astro";
---

<div class="py-6 container mx-auto border-t border-base-200">
  <SectionTitle>My Stack</SectionTitle>
  <div class="grid md:grid-cols-2 gap-x-6 pt-2">
    <StackItem
      title="Astro"
      description="Static Site Generator"
      icon="devicon:astro"
    />

    <StackItem
      title="Figma"
      description="Design Software"
      icon="devicon:figma"
    />

    <StackItem
      title="Webstorm"
      description="Code Editor"
      icon="devicon:webstorm"
    />

    <StackItem
      title="macOS"
      description="Operating System"
      icon="devicon:apple"
    />

    <StackItem
      title="Sentry"
      description="Error Tracking"
      icon="devicon:sentry"
    />
  </div>
</div>
