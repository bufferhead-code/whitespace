---
import SectionTitle from "../Common/SectionTitle.astro";
import StackCard from "./StackCard.astro";
---

<div class="pt-6 pb-12 container mx-auto border-t border-base-200">
  <SectionTitle>My Stack</SectionTitle>
  <div class="grid md:grid-cols-2 gap-4 pt-4">
    <StackCard
      title="Astro"
      description="Static Site Generator"
      icon="devicon:astro"
    />

    <StackCard
      title="Figma"
      description="Design Software"
      icon="devicon:figma"
    />

    <StackCard
      title="Webstorm"
      description="Code Editor"
      icon="devicon:webstorm"
    />

    <StackCard
      title="macOS"
      description="Operating System"
      icon="devicon:apple"
    />

    <StackCard
      title="Sentry"
      description="Error Tracking"
      icon="devicon:sentry"
    />
  </div>
</div>
