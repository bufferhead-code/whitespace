---
import ButtonPrimary from "../Button/ButtonPrimary.astro";
---

<div class="container mx-auto isolate relative z-10 py-6">
  <div
    class="bg-white rounded-xl border border-base-200 px-6 py-4 flex flex-col sm:flex-row justify-between items-center gap-6"
  >
    <div class="space-y-0.5">
      <h2 class="text-2xl sm:text-3xl font-semibold text-base-800">
        Wanna work together?
      </h2>
      <p class="text-xl sm:text-2xl font-medium text-base-500">
        Let's talk about it!
      </p>
    </div>
    <ButtonPrimary> Contact me </ButtonPrimary>
  </div>
</div>
