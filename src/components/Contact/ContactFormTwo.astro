---
import { Image } from "astro:assets";
import FormInputField from "../Common/Form/FormInputField.astro";
import FormInputTextarea from "../Common/Form/FormInputTextarea.astro";
import ButtonPrimary from "../Button/ButtonPrimary.astro";
import servicesExampleImage from "@assets/placeholder/services_example.jpg";
import { Icon } from "astro-icon/components";
import { socialItems } from "../../config/navigation";
---

<div
  class="flex items-center justify-center px-4 py-8 border-t border-base-200 container mx-auto relative irolate"
>
  <div
    class="overflow-hidden w-full flex gap-y-4 gap-x-12 flex-col md:flex-row relative items-center"
  >
    <div class="md:w-3/7 flex">
      <Image
        src={servicesExampleImage}
        alt="Contact me"
        class="w-full aspect-3/4 max-h-full object-cover rounded-lg"
      />
    </div>
    <div class="md:w-4/7">
      <h2 class="text-3xl font-bold mb-2">Work with me</h2>
      <p class="text-base-600 mb-6">
        Lorem aliquip sit consequat tempor voluptate cupidatat elit cillum
        consectetur duis.
      </p>
      <div class="flex space-x-4 mb-6">
        {
          socialItems.map((item) => (
            <a href={item.url} class="text-base-400 hover:text-base-600">
              <Icon name={item.icon} class="w-6 h-6" />
            </a>
          ))
        }
      </div>
      <form class="space-y-3">
        <FormInputField label="Name" name="name" />

        <FormInputField label="Email" name="email" />

        <FormInputTextarea label="Message" name="message" />

        <ButtonPrimary> Send</ButtonPrimary>
      </form>
    </div>
  </div>
</div>
