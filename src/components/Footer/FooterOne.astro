<footer class="isolate mx-auto container py-10 border-t border-gray-200">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-8">
    <!-- Logo -->
    <div class="lg:col-span-1">
      <a href="/" class="text-2xl font-bold">ACME Corp.</a>
    </div>

    <!-- Home -->
    <div class="lg:col-span-1">
      <h2 class="font-semibold text-gray-900 mb-4">Home</h2>
      <ul class="space-y-2">
        <li>
          <a href="/home-1" class="text-gray-600 hover:text-gray-900">Home 1</a>
        </li>
        <li>
          <a href="/home-2" class="text-gray-600 hover:text-gray-900">Home 2</a>
        </li>
      </ul>
    </div>

    <!-- Pages -->
    <div class="lg:col-span-1">
      <h2 class="font-semibold text-gray-900 mb-4">Pages</h2>
      <ul class="space-y-2">
        <li>
          <a href="/about" class="text-gray-600 hover:text-gray-900">About us</a
          >
        </li>
        <li>
          <a href="/contact" class="text-gray-600 hover:text-gray-900"
            >Contact</a
          >
        </li>
        <li>
          <a href="/projects" class="text-gray-600 hover:text-gray-900"
            >Projects</a
          >
        </li>
        <li>
          <a href="/services" class="text-gray-600 hover:text-gray-900"
            >Services</a
          >
        </li>
      </ul>
    </div>

    <!-- Theme -->
    <div class="lg:col-span-1">
      <h2 class="font-semibold text-gray-900 mb-4">Theme</h2>
      <ul class="space-y-2">
        <li>
          <a href="/license" class="text-gray-600 hover:text-gray-900"
            >License</a
          >
        </li>
        <li>
          <a href="/support" class="text-gray-600 hover:text-gray-900"
            >Support</a
          >
        </li>
        <li>
          <a href="/docs" class="text-gray-600 hover:text-gray-900">Docs</a>
        </li>
      </ul>
    </div>

    <!-- Social -->
    <div class="lg:col-span-1">
      <h2 class="font-semibold text-gray-900 mb-4">Social</h2>
      <ul class="space-y-2">
        <li>
          <a
            href="https://facebook.com"
            class="text-gray-600 hover:text-gray-900">Facebook</a
          >
        </li>
        <li>
          <a
            href="https://twitter.com"
            class="text-gray-600 hover:text-gray-900">Twitter/X</a
          >
        </li>
        <li>
          <a
            href="https://linkedin.com"
            class="text-gray-600 hover:text-gray-900">LinkedIn</a
          >
        </li>
      </ul>
    </div>

    <!-- Office -->
    <div class="lg:col-span-1">
      <h2 class="font-semibold text-gray-900 mb-4">Office</h2>
      <address class="not-italic text-gray-600">
        Main Street 123<br />
        Anytown<br />
        World
      </address>
    </div>
  </div>

  <!-- Bottom bar -->
  <div
    class="mt-16 pt-8 border-t border-gray-200 flex flex-col sm:flex-row justify-between items-center"
  >
    <p class="text-gray-600">&copy; Copyright 2024 ACME Corp.</p>
    <a href="#top" class="text-gray-600 hover:text-gray-900 mt-4 sm:mt-0"
      >Back to top</a
    >
  </div>
</footer>
