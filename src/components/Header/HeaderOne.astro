---
import { Icon } from "astro-icon/components";
import { navigationItems, socialItems } from "../../config/navigation";
---

<div class="w-full h-10">
  <div class="w-full flex py-6 justify-center px-12 isolate relative z-30">
    <header
      class="mx-auto fixed px-5 container py-3 w-[95%] md:w-full rounded-xl shadow-xs z-20 border border-gray-200 bg-white/90 backdrop-blur-lg"
    >
      <nav class="w-full flex items-center justify-between">
        <div class="flex gap-4">
          <a
            href="/"
            class="text-gray-700 hover:text-gray-900 transition font-semibold md:border-r text-lg border-gray-200 pr-6 py-0.5"
            >WHITESPACE</a
          >
          <div class="hidden md:flex items-center text-sm gap-1.5 font-medium">
            {
              navigationItems.map((item) => (
                <div class="relative group">
                  {item.items ? (
                    <>
                      <button
                        class:list={[
                          `text-gray-500 hover:text-gray-900 transition group-hover:bg-gray-50 cursor-pointer rounded-lg px-2.5 py-1.5 transition`,
                          { "flex items-center": item.items },
                        ]}
                      >
                        <span>{item.title}</span>
                        <Icon
                          name="mdi:chevron-down"
                          class="text-gray-300 relative -right-1 group-hover:text-gray-500 transition w-5 h-5"
                        />
                      </button>
                      <div class="absolute left-0 hidden w-max group-hover:block bg-white shadow-lg pt-2 rounded-md">
                        {item.items.map((subItem) => (
                          <a
                            href={subItem.url}
                            class="block px-4 py-2 text-gray-500 hover:text-gray-900 transition"
                          >
                            {subItem.title}
                          </a>
                        ))}
                      </div>
                    </>
                  ) : (
                    <a
                      href={item.url}
                      class:list={[
                        `text-gray-500 rounded-lg group-hover:bg-gray-50 px-2.5 py-1.5 transition hover:text-gray-900 transition`,
                        { "flex items-center": item.items },
                      ]}
                    >
                      {item.title}
                    </a>
                  )}
                </div>
              ))
            }
          </div>
        </div>
        <div class="hidden md:flex items-center gap-4 pr-2">
          {
            socialItems.map((item) => (
              <a href={item.url} class="text-gray-400 hover:text-gray-900">
                <Icon name={item.icon} class="w-6 h-6" />
                <span class="sr-only">{item.title}</span>
              </a>
            ))
          }
        </div>
        <div class="md:hidden flex">
          <button
            data-menu-trigger
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="group"
          >
            <Icon
              name="mdi:menu"
              class="w-6 h-6 text-gray-500 group-aria-expanded:hidden block"
            />
            <Icon
              name="mdi:close"
              class="w-6 h-6 text-gray-500 group-aria-expanded:block hidden"
            />
          </button>
        </div>
      </nav>
    </header>
    <div
      id="mobile-menu"
      aria-hidden="true"
      class="aria-hidden:hidden w-screen h-screen z-10 fixed top-0 left-0 bg-white/90 backdrop-blur-sm"
    >
      <div class="flex flex-col h-full pt-30">
        <div class="flex flex-col gap-6 px-6">
          {
            navigationItems.map((item) => (
              <div>
                {item.items && item.items.length > 0 ? (
                  <>
                    <span class="font-semibold text-sm text-gray-400">
                      {item.title}
                    </span>
                    <div class="">
                      {item.items.map((subItem) => (
                        <a
                          href={subItem.url}
                          class="text-gray-700 hover:text-gray-900 transition block font-medium"
                        >
                          {subItem.title}
                        </a>
                      ))}
                    </div>
                  </>
                ) : (
                  <a
                    href={item.url}
                    class="text-gray-700 hover:text-gray-900 transition font-medium block"
                  >
                    {item.title}
                  </a>
                )}
              </div>
            ))
          }
        </div>
        <div class="flex gap-4 pt-8 mx-auto">
          {
            socialItems.map((item) => (
              <a href={item.url} class="text-gray-400 hover:text-gray-900">
                <Icon name={item.icon} class="w-6 h-6" />
                <span class="sr-only">{item.title}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const buttons = document.querySelectorAll("[data-menu-trigger]");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        button.setAttribute(
          "aria-expanded",
          button.getAttribute("aria-expanded") === "true" ? "false" : "true",
        );
        const controlElementId = button.getAttribute("aria-controls");
        if (controlElementId) {
          const menu = document.getElementById(controlElementId);
          if (menu) {
            menu.setAttribute(
              "aria-hidden",
              menu.getAttribute("aria-hidden") === "true" ? "false" : "true",
            );
          }
        }
      });
    });
  });
</script>
