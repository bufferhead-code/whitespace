---
import { navigationItems, socialItems } from "../../config/navigation";
import { Icon } from "astro-icon/components";
---

<div class="w-full h-8">
  <div
    class="w-full fixed flex justify-center border-base-200 border-b isolate z-30 bg-white/80 backdrop-blur-lg"
  >
    <header class="mx-auto px-5 py-3.5 container w-full rounded-xl">
      <nav class="w-full flex items-center justify-between">
        <div class="hidden md:flex items-center text-sm gap-6 font-medium">
          <a
            href="/"
            class="text-base-700 hover:text-base-900 transition font-semibold border-r text-lg border-base-200 pr-6 py-0.5"
            >WHITESPACE</a
          >
          {
            navigationItems.map((item) => (
              <a
                href={item.url}
                class="text-base-500 hover:text-base-900 transition"
              >
                {item.title}
              </a>
            ))
          }
        </div>

        <div class="flex items-center gap-4 pr-2">
          {
            socialItems.map((item) => (
              <a href={item.url} class="text-base-400 hover:text-base-900">
                <Icon name={item.icon} class="w-5 h-5" />
                <span class="sr-only">{item.title}</span>
              </a>
            ))
          }
        </div>
      </nav>
    </header>
  </div>
</div>
