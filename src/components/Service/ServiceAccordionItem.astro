---
import { twMerge } from "tailwind-merge";
import { Icon } from "astro-icon/components";
interface Props {
  title: string;
  prefix?: string;
  class?: string;
  icon?: string;
  open?: boolean;
}

const { title, open, prefix, class: className, icon } = Astro.props;
---

<details open={open} class:list={twMerge("pt-2", className)}>
  <summary
    class="w-full flex items-center justify-between text-left cursor-pointer"
  >
    <div class="flex items-center gap-4">
      {icon && <Icon name={icon} class="h-7 w-7 text-indigo-500" />}
      {
        prefix && (
          <span class="text-[#6366F1] text-2xl font-semibold min-w-[35px]">
            {prefix}
          </span>
        )
      }
      <span class="text-2xl font-semibold">{title}</span>
    </div>
    <svg
      class="w-6 h-6 text-gray-400"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 9l-7 7-7-7"></path>
    </svg>
  </summary>
  <div class="pt-1.5 pl-13 pr-6 prose prose-sm">
    <slot />
  </div>
</details>
