---
interface Props {
  class?: string;
  tag?: string;
  href?: string;
  target?: string;
}

const { class: className, tag = "button", href, ...props } = Astro.props;
---

{
  tag === "a" ? (
    <a href={href} class:list={className} {...props}>
      <slot />
    </a>
  ) : (
    <button class:list={className} {...props}>
      <slot />
    </button>
  )
}
