---
import Button from "./Button.astro";
import { twMerge } from "tailwind-merge";

interface Props {
  class?: string;
  tag?: string;
  href?: string;
  target?: string;
}

const { class: className, tag = "button", href, ...props } = Astro.props;
---

<Button
  class:list={twMerge(
    "px-4 py-2 border border-base-300 bg-white rounded-md hover:bg-base-100 font-medium shadow-sm text-sm transition-colors cursor-pointer",
    className,
  )}
  tag={tag}
  href={tag === "a" ? href : undefined}
  {...props}
>
  <slot />
</Button>
