---
import { Icon } from "astro-icon/components";
interface Props {
  count: string;
  title: string;
  icon?: string;
}

const { count, title, icon } = Astro.props;
---

<div
  class="px-2 lg:px-3 py-3 flex items-center rounded-2xl border border-base-200 bg-white/80 backdrop-blur shadow-xs"
>
  <div class="space-y-2 w-full">
    <div class="text-3xl lg:text-5xl px-2 font-semibold text-base-800">
      {count}
    </div>
    <div
      class="flex space-x-2 items-center px-2 font-semibold border-t border-base-200 pt-2"
    >
      {icon && <Icon name={icon} class="h-5 w-5 text-primary-400" />}
      <span>
        {title}
      </span>
    </div>
  </div>
</div>
