---
import BackgroundGradient from "../Common/Background/BackgroundGradient.astro";
import AboutCard from "./AboutCard.astro";
---

<div class="container isolate relative mx-auto py-12 border-t border-base-200">
  <BackgroundGradient class="max-w-3xl -right-[20%] -top-[50%]" />
  <div class="grid lg:grid-cols-2 relative gap-12 items-start">
    <!-- Left Column -->
    <div class="space-y-8 flex flex-col justify-between h-full">
      <h1 class="text-xl lg:text-4xl max-w-xl font-semibold leading-tight">
        I am a fullstack web developer who crafts exceptional web experiences.
      </h1>
      <div>
        <a
          href="#work"
          class="inline-block text-primary-600 hover:border-base-400 transition hover:text-primary-700 border-b-2 border-base-300 text-base lg:text-lg font-semibold"
        >
          Check out my work
        </a>
      </div>
    </div>

    <!-- Right Column -->
    <div class="grid gap-6">
      <!-- Stats Grid -->
      <div class="grid lg:grid-cols-2 gap-6">
        <!-- Projects Card -->
        <AboutCard icon="mdi:cube" title="Completed Projects" count="100+" />
        <AboutCard
          icon="mdi:briefcase"
          title="Years of Experience"
          count="10"
        />
      </div>

      <!-- Coffee Card -->
      <AboutCard icon="mdi:coffee" title="Cups of Coffee" count="100+" />
    </div>
  </div>
</div>
