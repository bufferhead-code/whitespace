---
import { Image } from "astro:assets";
import headerPortrait from "../../assets/header_portrait.png";
import ButtonPrimary from "../Button/ButtonPrimary.astro";
import ButtonSecondary from "../Button/ButtonSecondary.astro";
import BackgroundGradient from "../Common/Background/BackgroundGradient.astro";
---

<div
  class="container mx-auto isolate px-4 pt-20 pb-12 md:pt-24 md:pb-16 relative"
>
  <BackgroundGradient class="right-[-25%] top-[-20%] max-w-4xl" />
  <div
    class="flex flex-col md:flex-row gap-8 md:gap-12 lg:gap-18 items-center relative"
  >
    <div class="relative w-1/3 mx-auto md:mx-0">
      <Image
        src={headerPortrait}
        alt="A portrait picture"
        class="rounded-3xl w-full h-full object-cover"
      />
    </div>
    <div class="space-y-3 flex-1 text-center md:text-left">
      <p class="font-semibold text-primary-500">Oh, Hello there!</p>
      <h1
        class="text-2xl md:text-3xl lg:text-4xl font-bold max-w-2xl leading-tight"
      >
        I'm John Doe, a fullsnack developer and designer from Austria.
      </h1>
      <p class="text-base-600 max-w-xl">
        I specialize in developing high-performance web applications, focusing
        on scalability, security, and seamless user experiences.
      </p>
      <div
        class="flex pt-3 flex-col sm:flex-row gap-4 justify-center md:justify-start"
      >
        <ButtonPrimary> Check out my work </ButtonPrimary>
        <ButtonSecondary> Contact me </ButtonSecondary>
      </div>
    </div>
  </div>
</div>
