---
import { Image } from "astro:assets";
import headerPortrait from "../../assets/header_portrait.png";
import ButtonPrimary from "../Button/ButtonPrimary.astro";
import ButtonSecondary from "../Button/ButtonSecondary.astro";
import BackgroundGradient from "../Common/Background/BackgroundGradient.astro";
---

<div>
  <div class="container mx-auto px-4 pt-18 lg:pt-24 pb-12 lg:pb-18 max-w-6xl relative">
    <BackgroundGradient class="right-[-25%] top-[-25%] max-w-4xl" />
    <div class="space-y-5 lg:space-y-8">
      <!-- Profile section -->
      <div class="flex items-center gap-4">
        <Image
          src={headerPortrait}
          alt="A portrait picture"
          class="w-20 h-20 rounded-full border-4 border-white shadow-lg"
        />
        <p class="text-gray-600 max-w-2xl text-xs lg:text-base">
          Occaecat elit eiusmod est ut eiusmod exercitation dolore consectetur.
          Laboris sint veniam enim sit enim mollit veniam incididunt consequat
          irure officia excepteur cillum incididunt duis.
        </p>
      </div>

      <!-- Heading -->
      <div class="space-y-2">
        <h1 class="text-4xl lg:text-6xl font-semibold text-gray-900">
          Webdeveloper <br />
          <span class="text-gray-500">and</span> Webdesigner
        </h1>
      </div>

      <!-- Buttons -->
      <div class="flex gap-4">
        <ButtonPrimary>Check out my work</ButtonPrimary>
        <ButtonSecondary>Contact me</ButtonSecondary>
      </div>
    </div>
  </div>
</div>
