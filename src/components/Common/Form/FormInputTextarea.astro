---
interface Props {
  label: string;
  name: string;
}

const { label, name } = Astro.props;
---

<div>
  <label for={name} class="block text-sm font-medium text-gray-900"
    >{label}</label
  >
  <textarea
    id={name}
    aria-labelledby={name}
    name={name}
    rows="6"
    class="mt-1 py-1.5 px-2.5 block w-full bg-white rounded-md border border-gray-200 shadow-xs focus:border-indigo-500 focus:ring-indigo-500"
  ></textarea>
</div>
