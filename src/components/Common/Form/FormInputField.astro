---
interface Props {
  label: string;
  name: string;
}

const { label, name } = Astro.props;
---

<div>
  <label for={name} class="block text-sm font-medium text-base-900"
    >{label}</label
  >
  <input
    type="text"
    aria-labelledby={name}
    id={name}
    name={name}
    class="mt-1 py-1.5 px-2 block w-full bg-white rounded-md border border-base-200 shadow-xs focus:border-primary-500 focus:ring-primary-500"
  />
</div>
