---
import { Image } from "astro:assets";

interface Props {
  title: string;
  image: ImageMetadata;
}

const { title, image } = Astro.props;
---

<div
  class="flex items-center py-6 px-3 bg-white rounded-2xl flex justify-center shadow-xs border border-base-200"
>
  <Image class="h-10 select-none w-full" src={image} alt={title} />
</div>
