---
import Layout from "../layouts/Layout.astro";
import HeroSectionTwo from "../components/Hero/HeroSectionTwo.astro";
import ProjectSectionTwo from "../components/Project/ProjectSectionTwo.astro";
import ServiceSectionTwo from "../components/Service/ServiceSectionTwo.astro";
import ExperienceSectionTwo from "../components/Experience/ExperienceSectionTwo.astro";
import ContactFormTwo from "../components/Contact/ContactFormTwo.astro";
import StackSectionTwo from "../components/Stack/StackSectionTwo.astro";
import TestimonialSectionOne from "../components/Testimonial/TestimonialSectionOne.astro";
import { SEO } from "astro-seo";
---

<Layout>
  <Fragment slot="head">
    <SEO
      description="Build Astro websites superfast, with easy to customize themes."
      title="Whitespace Premium Astro Theme - Bufferthemes"
    />
  </Fragment>
  <HeroSectionTwo />
  <ProjectSectionTwo />
  <ServiceSectionTwo />
  <StackSectionTwo />
  <TestimonialSectionOne />
  <ExperienceSectionTwo />
  <ContactFormTwo />
</Layout>
