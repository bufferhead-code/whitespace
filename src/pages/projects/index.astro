---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/Project/ProjectCard.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
// sort by priority
allProjects.sort((a, b) => b.data.priority - a.data.priority);
---

<Layout>
  <div class="pt-24">
    <div
      class="space-y-3 flex-1 text-center md:text-left container mx-auto pb-10"
    >
      <p class="font-semibold text-indigo-500">Check out my work!</p>
      <h1
        class="text-2xl md:text-3xl lg:text-4xl font-bold max-w-2xl leading-tight"
      >
        All Projects
      </h1>
      <p class="text-gray-600 max-w-xl">
        See what I've been working on lately and get in touch if you'd like to
        collaborate. I'm always open to new projects!
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12 container mx-auto">
      {
        allProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            logo={project.data.logo}
            image={project.data.image}
          />
        ))
      }
    </div>
  </div>
</Layout>
