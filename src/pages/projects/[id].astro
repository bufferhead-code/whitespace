---
import { getCollection } from "astro:content";
import { getEntry, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { SEO } from "astro-seo";

// 1. Get the slug from the incoming server request
const { id } = Astro.params;
if (id === undefined) {
  return Astro.redirect("/404");
}
// 2. Query for the entry directly using the request slug
const post = await getEntry("projects", id);
// 3. Redirect if the entry does not exist
if (post === undefined) {
  return Astro.redirect("/404");
}

export async function getStaticPaths() {
  const posts = await getCollection("projects");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { Content } = await render(post);
---

<Layout>
  <Fragment slot="head">
    <SEO
      description="Build Astro websites superfast, with easy to customize themes."
      title={post.data.title + "Whitespace Project - Bufferthemes"}
    />
  </Fragment>

  <div class="container mx-auto py-24">
    <div class="flex-1 container mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 items-center justify-between">
        <div class="col-span-2 space-y-3 py-6">
          {
            post.data.year && (
              <p class="font-semibold text-primary-500">{post.data.year}</p>
            )
          }
          <h1
            class="text-2xl md:text-3xl lg:text-4xl font-bold max-w-2xl leading-tight"
          >
            {post.data.title}
          </h1>
          <p class="text-base-600 text-sm md:text-base font-medium max-w-xl">
            {post.data.description}
          </p>
          <div>
            {
              post.data.tags && (
                <div class="flex gap-3 mt-4 items-center">
                  <div class="text-base-500 font-semibold text-xs">Tags:</div>
                  {post.data.tags.map((tag) => (
                    <span class="px-3 py-1.5 rounded-full bg-base-100 font-medium text-base-700 text-xs">
                      {tag}
                    </span>
                  ))}
                </div>
              )
            }
          </div>
        </div>
        <div class="-order-1 md:order-1">
          <Image
            src={post.data.image}
            alt={post.data.title}
            class="w-full border border-base-200 shadow-xs object-cover transition duration-500 object-top rounded-lg"
          />
        </div>
      </div>
      <div class="prose prose-sm md:prose-base pt-8 border-t border-base-200">
        <Content />
      </div>
    </div>
  </div>
</Layout>
