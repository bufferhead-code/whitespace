---
import { sections } from "../../config/sections";
import Layout from "../../layouts/Layout.astro";

const { slug } = Astro.params;
if (slug === undefined) {
  return Astro.redirect("/404");
}
const category = sections.find((section) => section.slug === slug);
if (category === undefined) {
  return Astro.redirect("/404");
}

export async function getStaticPaths() {
  return sections.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}
---

<Layout>
  <div class="container mx-auto pt-32">
    <div class="pb-10 space-y-1.5">
      <h1
        class="text-2xl md:text-3xl lg:text-4xl font-bold max-w-2xl leading-tight"
      >
        {category.title}
      </h1>
      <p class="text-base-600 text-sm md:text-base font-medium max-w-md">
        This page lists all available {category.title} components that you can use
        withing the Whitespace theme.
      </p>
    </div>
    <div class="grid grid-cols-1 gap-8 mb-12">
      {
        category.components.map((component) => (
          <div class="border border-base-200 rounded-lg overflow-hidden">
            <div class="flex space-x-2 bg-base-50 items-center justify-between border-b border-base-200  py-1.5 px-3">
              <h2 class="font-semibold text-lg py-1.5 px-2">
                {component.title}
              </h2>
              <div class="bg-base-100 border border-base-200 rounded font-mono text-base-700 text-xs px-2 py-1 font-semibold">
                {component.path}
              </div>
            </div>
            <component.component />
          </div>
        ))
      }
    </div>
  </div>
</Layout>
